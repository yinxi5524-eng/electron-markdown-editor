{
  "name": "markdown-notes",
  "version": "1.0.0",
  "author": "yinxi5524-eng",
  "description": "2026年底的风吹来一个markdown编辑器 - 基于 Electron 的 Markdown 笔记应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "nodemon --exec electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir",
    "dist:repack": "electron-builder --win nsis portable --prepackaged dist/win-unpacked"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yinxi5524eng.markdown-notes",
    "productName": "2026年底的风吹来一个markdown编辑器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "shortcutName": "markdown编辑器"
    }
  }
}
